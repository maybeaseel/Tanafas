<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tanaffas.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="12">
            <Label Style="{StaticResource Heading}" Text="تنفـــس" FontSize="40" HorizontalOptions="Center" />
            <Label Style="{StaticResource Muted}" Text="رفيقك الموثوق لصحة تنفسية هادئة" HorizontalOptions="Center" />

            <Label Style="{StaticResource Heading}" Text="تسجيل الدخول" Margin="0,24,0,0" />
            <Label Style="{StaticResource Muted}" Text="مرحبًا بعودتك إلى مساحتك الآمنة" />

            <Label Style="{StaticResource FieldLabel}" Text="البريد الإلكتروني" Margin="0,12,0,0" />
            <Border Style="{StaticResource Field}">
                <Entry Text="{Binding Email}" Keyboard="Email" MaxLength="80" Placeholder="name@example.com" />
            </Border>
            <Label Style="{StaticResource ErrorLabel}" Text="{Binding EmailError}"
                   IsVisible="{Binding EmailError, Converter={StaticResource NotEmpty}}" />

            <Label Style="{StaticResource FieldLabel}" Text="كلمة المرور" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" Placeholder="••••••••" />
                    <Button Grid.Column="1" Text="إظهار" BackgroundColor="Transparent"
                            TextColor="{StaticResource TnfPrimary}" Command="{Binding TogglePasswordCommand}" />
                </Grid>
            </Border>
            <Label Style="{StaticResource ErrorLabel}" Text="{Binding PasswordError}"
                   IsVisible="{Binding PasswordError, Converter={StaticResource NotEmpty}}" />

            <Label Style="{StaticResource LinkLabel}" Text="نسيت كلمة المرور؟" HorizontalOptions="End" />

            <Button Style="{StaticResource PrimaryButton}" Text="تسجيل الدخول" Command="{Binding SignInCommand}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource TnfPrimary}" />

            <VerticalStackLayout Spacing="0" Margin="0,16,0,0">
                <Label Text="ليس لديك حساب؟" HorizontalOptions="Center" />
                <Button Text="إنشاء حساب جديد" BackgroundColor="Transparent" TextColor="{StaticResource TnfPrimary}"
                        FontFamily="PlexSemiBold" HeightRequest="48" HorizontalOptions="Center"
                        Command="{Binding GoToRegisterCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
